{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Separate Worker for the new system (2026-11-08). NOT "sg16-brain-core":
  // that name is the live mistralbrain.com Worker and must never be deployed over.
  "name": "soverian-sg16-brain",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // the NEW Cloudflare account (2026-11-08): deploys can only land here
  "account_id": "3676a09b6ca7c6fb929833cb2e4d69f6",


  "observability": { "enabled": true },

  // FRESH DEPLOYMENT (2026-11-06): nothing here points at the old account.
  // Until the new domain exists the Worker runs on its free workers.dev
  // address. When the domain is added to the NEW Cloudflare account, add:
  //   "routes": [{ "pattern": "your-domain.com/*", "zone_name": "your-domain.com" }],
  // (see docs/FRESH-DEPLOY.md).
  "workers_dev": true,
  "preview_urls": false,

  // client/ is generated, not committed: every deploy (this PC or a Worker
  // connected to GitHub) first stages it from site/. Only site/ changes
  // re-run it under `wrangler dev`.
  "build": { "command": "node scripts/sync-web.mjs", "watch_dir": "site" },

  "assets": {
    "directory": "./client",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },

  // Fresh storage and database, created by the owner in the NEW account
  // (2026-11-08): KV "SOVERIAN_KV" and D1 "soverian-sg16-brain". Load the
  // tables once: npx wrangler d1 execute soverian-sg16-brain --remote --file schema.sql
  "kv_namespaces": [
    { "binding": "KEYS", "id": "b19a7624cea84f5cabb2d92f4a155668" }
  ],

  "d1_databases": [
    { "binding": "LOGS", "database_name": "soverian-sg16-brain", "database_id": "eecde4ef-563a-4c38-8c50-e2c157d923df" }
  ],

  // visitor sign-in codes (src/accounts.ts): Cloudflare Email Sending needs the
  // new domain onboarded (Email -> Email Sending, Workers Paid for any address).
  // When it is, uncomment this and set EMAIL_FROM below:
  // "send_email": [{ "name": "EMAIL" }],

  "durable_objects": {
    "bindings": [
      { "name": "QUEUE", "class_name": "InferenceQueueDO" },
      { "name": "MATRIX", "class_name": "MatrixDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InferenceQueueDO", "MatrixDO"] }
  ],

  "vars": {
    // the brain server (Ollama on the OVH VPS, 2026-11-08) behind the
    // Cloudflare Tunnel hostname. /admin -> BRAIN SERVER can switch it at any
    // time without a redeploy; this is only the default.
    "MODEL_URL": "https://internal.mistralbrain.com",
    // the one brain, exactly as published on Ollama (7.5 GB, 12.2B, Q4_K_M,
    // manifest f4b21a5d4668) — https://ollama.com/saiftechglobal/sg16-brain:Q4_K_M
    "MODEL_NAME": "saiftechglobal/sg16-brain:Q4_K_M",
    "MODEL_NUM_CTX": "8192",
    "MAX_OUTPUT_CHARS": "16384",
    // the 12B Q4_K_M brain needs time on CPU; 95s stays under
    // Cloudflare's ~100s origin-response cap on the tunnel. One chat holds the
    // slot for at most draft + retry + self-check = 3 x 95s = 285s < 300s lease.
    "INFERENCE_TIMEOUT_MS": "95000",
    "MAX_QUEUE_WAIT_MS": "120000",
    "SELF_CHECK": "false",
    "FREE_TOKEN_ALLOWANCE": "10000",
    // "EMAIL_FROM": "SG16 Brain <signin@your-domain.com>",
    "DODO_TEST_MODE": "false",
    // the same Dodo Payments products as before (owner decision 2026-11-06)
    "DODO_PRODUCT_IDS": "{\"day\":\"pdt_0NoUNgIwv3XfCVptVxLaa\",\"week\":\"pdt_0NoUNgD5Yjz1cRYOwIixQ\",\"half\":\"pdt_0NoUNg8AK64S8TkG2b5tK\",\"month\":\"pdt_0NoUNg3MglpZRU2yPvduq\"}"
    // payment return pages: the Worker's own address is always allowed; list
    // extra origins here only if a second site sends visitors to checkout
    // "ALLOWED_RETURN_ORIGINS": "https://your-domain.com"
  }
}